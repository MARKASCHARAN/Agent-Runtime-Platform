generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PolicySet {
  id          String   @id @default(uuid())
  name        String
  description String?
  version     Int      @default(1)
  rules       Json
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions   PolicyDecision[]

  @@index([projectId, createdAt])
}

model PolicyDecision {
  id               String    @id @default(uuid())
  policySetId      String
  policySet        PolicySet @relation(fields: [policySetId], references: [id])
  projectId        String
  actionIntent     String
  context          Json
  outcome          String
  decisionTrace    Json?
  isSimulation     Boolean   @default(false)
  traceId          String    @default(uuid())
  resolvedBy       String?
  resolvedAt       DateTime?
  executionEventId String?
  createdAt        DateTime  @default(now())

  @@index([policySetId, createdAt])
  @@index([projectId, createdAt])
}

model ExecutionEvent {
  id                  String   @id @default(uuid())
  replayCorrelationId String
  eventType           String
  payload             Json
  actorId             String
  projectId           String
  traceId             String?
  createdAt           DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([replayCorrelationId])
}

model ToolTrustProfile {
  id             String   @id @default(uuid())
  toolIdentity   String
  publisher      String
  schemaHash     String
  riskScore      Int      @default(0)
  trustStatus    String
  projectId      String
  lastVerifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([toolIdentity, projectId])
  @@index([projectId, createdAt])
}

model MemoryMutation {
  id             String   @id @default(uuid())
  agentId        String
  mutationType   String
  key            String
  previousValue  String?
  newValue       String?
  sourceMetadata Json
  anomalyScore   Float    @default(0.0)
  projectId      String
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([agentId, createdAt])
}
